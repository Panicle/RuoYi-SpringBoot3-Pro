<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.AlertMapper">

    <resultMap type="Alert" id="AlertResult">
        <id     property="alertId"     column="alert_id"     />
        <result property="alertType"   column="alert_type"   />
        <result property="refId"       column="ref_id"       />
        <result property="alertLevel"  column="alert_level"  />
        <result property="title"       column="title"        />
        <result property="content"     column="content"      />
        <result property="status"      column="status"       />
        <result property="delFlag"     column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
        <result property="projectId"   column="project_id"   />
        <result property="projectNo"   column="project_no"   />
        <result property="projectName" column="project_name" />
        <result property="category"    column="category"     />
    </resultMap>

    <!-- 经费预警视图：alert.ref_id → budget_split.split_id → project，权限沿此链判定。
         数据范围联接（@DataScope deptAlias=d / userAlias=u）：d = sys_dept、u = sys_user
         两个别名专供数据权限使用，不得被业务表占用（budget_split 用 bs、alert 用 a、project 用 p） -->
    <sql id="selectBudgetAlertVo">
        select a.alert_id, a.alert_type, a.ref_id, a.alert_level, a.title, a.content, a.status, a.del_flag,
               a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
               bs.project_id, bs.category,
               p.project_no, p.project_name
        from alert a
        join budget_split bs  on a.ref_id     = bs.split_id
        join project p        on bs.project_id = p.project_id
        left join sys_dept d  on p.dept_id    = d.dept_id
        left join sys_user u  on p.leader_id  = u.user_id
    </sql>

    <sql id="budgetAlertFilters">
        a.alert_type = 'BUDGET' and a.del_flag = '0' and bs.del_flag = '0' and p.del_flag = '0'
        <if test="projectId != null"> and bs.project_id = #{projectId} </if>
        <if test="status != null and status != ''"> and a.status = #{status} </if>
        <if test="alertLevel != null and alertLevel != ''"> and a.alert_level = #{alertLevel} </if>
    </sql>

    <!-- 列表：走 @DataScope 通道（deptAlias=d, userAlias=u），researcher 不调用此方法 -->
    <select id="selectBudgetAlertList" parameterType="Alert" resultMap="AlertResult">
        <include refid="selectBudgetAlertVo"/>
        <where>
            <include refid="budgetAlertFilters"/>
            <!-- 数据范围过滤（@DataScope 注入 params.dataScope） -->
            ${params.dataScope}
        </where>
        order by a.alert_id desc
    </select>

    <!-- researcher 列表（本人相关）：预警所属课题 leader_id = me OR 课题成员含 me -->
    <select id="selectBudgetAlertListForResearcher" parameterType="Alert" resultMap="AlertResult">
        <include refid="selectBudgetAlertVo"/>
        <where>
            <include refid="budgetAlertFilters"/>
            and (
                p.leader_id = #{params.selfUserId}
                or exists (
                    select 1 from project_member m
                     where m.project_id = p.project_id
                       and m.user_id    = #{params.selfUserId}
                       and m.del_flag   = '0'
                )
            )
        </where>
        order by a.alert_id desc
    </select>

    <!-- 幂等去重计数（§4.3）：同 ref_id 且 status ∈ (UNREAD, READ) 的未处理经费预警 -->
    <select id="countPendingBudgetAlert" resultType="java.lang.Integer">
        select count(*)
          from alert
         where alert_type = 'BUDGET'
           and ref_id     = #{refId}
           and del_flag   = '0'
           and status in ('UNREAD', 'READ')
    </select>
</mapper>
