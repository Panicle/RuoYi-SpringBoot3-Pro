<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BudgetSplitMapper">

    <resultMap type="BudgetSplit" id="BudgetSplitResult">
        <id     property="splitId"      column="split_id"      />
        <result property="projectId"    column="project_id"    />
        <result property="category"     column="category"      />
        <result property="budgetAmount" column="budget_amount" />
        <result property="delFlag"      column="del_flag"      />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <!-- 查询课题预算细分列表 -->
    <select id="selectByProjectId" parameterType="Long" resultMap="BudgetSplitResult">
        select split_id, project_id, category, budget_amount, del_flag,
               create_by, create_time, update_by, update_time, remark
        from budget_split
        where project_id = #{projectId}
          and del_flag   = '0'
        order by category
    </select>

    <!-- 批量插入预算细分 -->
    <insert id="batchInsert">
        insert into budget_split
            (project_id, category, budget_amount, del_flag, create_by, create_time, remark)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.projectId}, #{item.category}, #{item.budgetAmount}, #{item.delFlag}, #{item.createBy}, sysdate, #{item.remark})
        </foreach>
    </insert>

    <!-- 按课题逻辑删除预算细分（编辑全量替换前调用） -->
    <update id="deleteByProjectId">
        update budget_split
        set del_flag    = '2',
            update_time = sysdate
        where project_id = #{projectId}
          and del_flag   = '0'
    </update>
</mapper>
