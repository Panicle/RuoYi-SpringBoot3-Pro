<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.ProjectUnitMapper">

    <resultMap type="ProjectUnit" id="ProjectUnitResult">
        <id     property="id"               column="id"                 />
        <result property="projectId"        column="project_id"         />
        <result property="unitId"           column="unit_id"            />
        <result property="cooperationType"  column="cooperation_type"   />
        <result property="delFlag"          column="del_flag"           />
        <result property="createBy"         column="create_by"          />
        <result property="createTime"       column="create_time"        />
        <result property="updateBy"         column="update_by"          />
        <result property="updateTime"       column="update_time"        />
        <result property="remark"           column="remark"             />
        <result property="unitName"         column="unit_name"          />
        <result property="externalUnitType" column="external_unit_type" />
    </resultMap>

    <!-- 课题关联单位列表（JOIN cooperative_unit 返回 unitName/externalUnitType；del_flag='0'） -->
    <select id="selectProjectUnitList" parameterType="Long" resultMap="ProjectUnitResult">
        select pu.id, pu.project_id, pu.unit_id, pu.cooperation_type, pu.del_flag,
               pu.create_by, pu.create_time, pu.update_by, pu.update_time, pu.remark,
               cu.unit_name, cu.external_unit_type
        from project_unit pu
        left join cooperative_unit cu on pu.unit_id = cu.unit_id and cu.del_flag = '0'
        where pu.project_id = #{projectId} and pu.del_flag = '0'
        order by pu.id
    </select>

    <!-- 课题下某单位当前有效关联行（重复关联校验；del_flag='0'） -->
    <select id="selectByProjectAndUnit" resultMap="ProjectUnitResult">
        select id, project_id, unit_id, cooperation_type, del_flag,
               create_by, create_time, update_by, update_time, remark
        from project_unit
        where project_id = #{projectId} and unit_id = #{unitId} and del_flag = '0'
    </select>

    <!-- 统计某单位被有效关联数（删除保护：被引用拒；del_flag='0'） -->
    <select id="countByUnitId" parameterType="Long" resultType="int">
        select count(1)
        from project_unit
        where unit_id = #{unitId} and del_flag = '0'
    </select>

    <!-- 通过关联 id 反查所属 project_id（删除前数据权限校验；del_flag='0'） -->
    <select id="selectProjectIdById" parameterType="Long" resultType="java.lang.Long">
        select project_id from project_unit where id = #{id} and del_flag = '0'
    </select>

    <!-- 批量逻辑删除 -->
    <update id="softDeleteByIds">
        update project_unit
        set del_flag    = '2',
            update_by   = #{updateBy},
            update_time = sysdate
        where id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
          and del_flag = '0'
    </update>

</mapper>
